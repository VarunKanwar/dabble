{
  "name": "duckview",
  "displayName": "DuckView",
  "description": "Inspect Parquet, SQLite, and DuckDB files in VS Code — powered by native DuckDB.",
  "version": "0.1.0",
  "publisher": "VarunKanwar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VarunKanwar/dabble"
  },
  "homepage": "https://github.com/VarunKanwar/dabble#readme",
  "keywords": [
    "parquet",
    "duckdb",
    "sqlite",
    "data",
    "viewer"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "tsc -p tsconfig.extension.json",
    "build:webview": "tsc -p tsconfig.webview.json",
    "test": "npm run build:extension && node --test dist/extension/test/*.test.js",
    "check": "npm run build && npm run test",
    "package:vsix": "node scripts/package-vsix.mjs",
    "package:all": "node scripts/package-vsix.mjs --all"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.2-r.1"
  },
  "categories": [
    "Data Science",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:duckview.openSource",
    "onCommand:duckview.openAsParquetDataset",
    "onCommand:duckview.openWithDuckView",
    "onCustomEditor:duckview.viewer"
  ],
  "main": "./dist/extension/index.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "duckview.openSource",
        "title": "DuckView: Open Source"
      },
      {
        "command": "duckview.openAsParquetDataset",
        "title": "DuckView: Open as Parquet Dataset"
      },
      {
        "command": "duckview.openWithDuckView",
        "title": "DuckView: Open With DuckView"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "duckview.openWithDuckView",
          "when": "resourceExtname == .parquet || resourceExtname == .sqlite || resourceExtname == .db || resourceExtname == .duckdb",
          "group": "navigation"
        },
        {
          "command": "duckview.openAsParquetDataset",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "duckview.viewer",
        "displayName": "DuckView",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.sqlite"
          },
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.duckdb"
          }
        ],
        "priority": "default"
      }
    ],
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.parquet": "duckview.viewer",
        "*.sqlite": "duckview.viewer",
        "*.db": "duckview.viewer",
        "*.duckdb": "duckview.viewer"
      }
    },
    "configuration": {
      "title": "DuckView",
      "properties": {
        "duckview.previewLimit": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 5000,
          "description": "Default row limit for preview queries."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.1",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^6.0.3"
  }
}
