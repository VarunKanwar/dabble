{
  "name": "dabble",
  "displayName": "Dabble",
  "description": "Inspect Parquet, JSONL, SQLite, and DuckDB files in VS Code — powered by native DuckDB.",
  "icon": "media/icon.png",
  "version": "0.3.0",
  "publisher": "VarunKanwar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VarunKanwar/dabble"
  },
  "homepage": "https://github.com/VarunKanwar/dabble#readme",
  "keywords": [
    "parquet",
    "jsonl",
    "duckdb",
    "sqlite",
    "data",
    "viewer"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "tsc -p tsconfig.extension.json",
    "build:webview": "tsc -p tsconfig.webview.json",
    "test": "npm run build:extension && node --test dist/extension/test/*.test.js",
    "check": "npm run build && npm run test",
    "package:vsix": "node scripts/package-vsix.mjs",
    "package:all": "node scripts/package-vsix.mjs --all"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.2-r.1"
  },
  "categories": [
    "Data Science",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:dabble.openSource",
    "onCommand:dabble.openAsParquetDataset",
    "onCommand:dabble.openWithDabble",
    "onCustomEditor:dabble.viewer",
    "onCustomEditor:dabble.viewer.jsonl"
  ],
  "main": "./dist/extension/index.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dabble.openSource",
        "title": "Dabble: Open Source"
      },
      {
        "command": "dabble.openAsParquetDataset",
        "title": "Dabble: Open as Parquet Dataset"
      },
      {
        "command": "dabble.openWithDabble",
        "title": "Dabble: Open With Dabble"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "dabble.openWithDabble",
          "when": "resourceExtname == .parquet || resourceExtname == .jsonl || resourceExtname == .ndjson || resourceExtname == .sqlite || resourceExtname == .db || resourceExtname == .duckdb",
          "group": "navigation"
        },
        {
          "command": "dabble.openAsParquetDataset",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "dabble.viewer",
        "displayName": "Dabble",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.sqlite"
          },
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.duckdb"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "dabble.viewer.jsonl",
        "displayName": "Dabble",
        "selector": [
          {
            "filenamePattern": "*.jsonl"
          },
          {
            "filenamePattern": "*.ndjson"
          }
        ],
        "priority": "option"
      }
    ],
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.parquet": "dabble.viewer",
        "*.sqlite": "dabble.viewer",
        "*.db": "dabble.viewer",
        "*.duckdb": "dabble.viewer"
      }
    },
    "configuration": {
      "title": "Dabble",
      "properties": {
        "dabble.previewLimit": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 5000,
          "description": "Default row limit for preview queries."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.1",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^6.0.3"
  }
}
