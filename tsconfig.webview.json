{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "dist/webview",
    "rootDir": "src",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "sourceMap": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/webview.ts",
    "src/webview/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
